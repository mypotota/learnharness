<?xml version="1.0" encoding="utf-8"?>
<!-- The in-app launch surface: shown from the first frame until the real
     document has painted (MainActivity.revealPage). Same composition as the
     Android 12+ system splash, so the hand-over is invisible: brand mark,
     wordmark, one thin progress line. Colours come from colors.xml /
     values-night so it follows the system light/dark setting. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/splash_background">

    <LinearLayout
        android:id="@+id/splash_brand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:layout_width="132dp"
            android:layout_height="132dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_splash_mark" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:letterSpacing="0.32"
            android:text="@string/splash_wordmark"
            android:textAllCaps="true"
            android:textColor="@color/splash_text"
            android:textSize="11sp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/splash_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="88dp"
        android:layout_height="2dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="88dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/splash_progress"
        android:progressBackgroundTint="@android:color/transparent" />

    <TextView
        android:id="@+id/splash_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:paddingLeft="32dp"
        android:paddingRight="32dp"
        android:text="@string/startup_failure"
        android:textColor="@color/splash_mark"
        android:visibility="gone" />
</FrameLayout>
